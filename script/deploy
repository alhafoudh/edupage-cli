#!/usr/bin/env ruby
# Builds the image on the Docker host behind Portainer and (re)deploys the public MCP stack.
#
#   script/deploy            build + deploy
#   script/deploy build      only build the image
#   script/deploy stack      only create/update the stack (uses the image already on the host)
#
# Portainer URL and token come from the portainerctl context (~/.portainerctl/config.yaml,
# context PORTAINER_CONTEXT, default "obiwan") or PORTAINERCTL_URL / PORTAINERCTL_TOKEN.
# The image is built on the host (Docker build API proxied by Portainer), there is no registry.
# Stack environment = every EDUPAGE_* variable from .env.
#
# `portainerctl docker` cannot be used for the build (its docker passthrough rejects the https
# endpoint) and `portainerctl stack deploy-compose` cannot set stack env vars, hence the API calls.

require "json"
require "net/http"
require "openssl"
require "rubygems/package"
require "stringio"
require "uri"
require "yaml"

ROOT = File.expand_path("..", __dir__)
STACK_NAME = "edupage".freeze
IMAGE = "edupage-cli:latest".freeze
ENDPOINT_ID = Integer(ENV.fetch("PORTAINER_ENDPOINT_ID", "4"))
# What the Dockerfile needs to build the gem: the gemspec and every file it packages.
CONTEXT_FILES = %w[Dockerfile .dockerignore edupage-cli.gemspec README.md LICENSE lib exe].freeze

def portainer
  @portainer ||= begin
    if ENV["PORTAINERCTL_URL"] && ENV["PORTAINERCTL_TOKEN"]
      { url: ENV["PORTAINERCTL_URL"], token: ENV["PORTAINERCTL_TOKEN"], insecure: ENV["PORTAINERCTL_INSECURE"] == "true" }
    else
      name = ENV.fetch("PORTAINER_CONTEXT", "obiwan")
      config = YAML.load_file(File.expand_path("~/.portainerctl/config.yaml"))
      ctx = config.fetch("contexts").find { |c| c["name"] == name } or abort "portainerctl context #{name.inspect} not found"
      { url: ctx.fetch("url"), token: ctx.fetch("token"), insecure: ctx["insecure"] == true }
    end
  end
end

def http_request(req, stream: false, &block)
  uri = req.uri
  req["X-API-Key"] = portainer[:token]
  opts = { use_ssl: uri.scheme == "https", read_timeout: 1800, open_timeout: 15 }
  opts[:verify_mode] = OpenSSL::SSL::VERIFY_NONE if portainer[:insecure]
  Net::HTTP.start(uri.host, uri.port, **opts) do |http|
    http.request(req) do |res|
      if stream && res.is_a?(Net::HTTPSuccess)
        res.read_body(&block)
        return res
      end
      body = res.read_body
      abort "#{req.method} #{uri.path}: HTTP #{res.code} #{body}" unless res.is_a?(Net::HTTPSuccess)
      return body.to_s.empty? ? nil : JSON.parse(body)
    end
  end
end

def api(path) = URI("#{portainer[:url].chomp("/")}/api/#{path}")

def build_context
  io = StringIO.new
  Gem::Package::TarWriter.new(io) do |tar|
    CONTEXT_FILES.each do |entry|
      Dir.glob(File.join(ROOT, entry, "**", "*")).push(File.join(ROOT, entry)).uniq.sort.each do |path|
        next unless File.file?(path)

        rel = path.delete_prefix("#{ROOT}/")
        tar.add_file_simple(rel, File.stat(path).mode & 0o777, File.size(path)) { |f| f.write(File.binread(path)) }
      end
    end
  end
  io.string
end

def build
  context = build_context
  puts "building #{IMAGE} on endpoint #{ENDPOINT_ID} (context #{context.bytesize / 1024} KiB)"
  req = Net::HTTP::Post.new(api("endpoints/#{ENDPOINT_ID}/docker/build?t=#{URI.encode_www_form_component(IMAGE)}&rm=1&forcerm=1"))
  req["Content-Type"] = "application/x-tar"
  req.body = context
  buffer = +""
  error = nil
  http_request(req, stream: true) do |chunk|
    buffer << chunk
    while (line = buffer.slice!(/\A[^\n]*\n/))
      next if line.strip.empty?

      msg = begin
        JSON.parse(line)
      rescue JSON::ParserError
        { "stream" => line }
      end
      print msg["stream"] if msg["stream"]
      puts msg["status"] if msg["status"]
      error ||= msg["error"]
    end
  end
  abort "build failed: #{error}" if error
  puts "build ok"
end

def stack_env
  path = File.join(ROOT, ".env")
  abort ".env is missing (see the README section on public hosting)" unless File.exist?(path)

  env = File.readlines(path, chomp: true).filter_map do |line|
    next if line.strip.empty? || line.lstrip.start_with?("#")

    key, value = line.split("=", 2)
    next unless key&.start_with?("EDUPAGE_")

    value = value.to_s.strip
    value = value[1..-2] if value.length >= 2 && ['"', "'"].include?(value[0]) && value[-1] == value[0]
    { "name" => key, "value" => value }
  end
  missing = %w[EDUPAGE_PUBLIC_URL EDUPAGE_SECRET_KEY] - env.map { |e| e["name"] }
  abort ".env is missing #{missing.join(", ")}" unless missing.empty?
  env
end

def deploy_stack
  compose = File.read(File.join(ROOT, "deploy", "compose.yml"))
  env = stack_env
  stacks = http_request(Net::HTTP::Get.new(api("stacks")))
  existing = stacks.find { |s| s["Name"] == STACK_NAME && s["EndpointId"] == ENDPOINT_ID }
  if existing
    puts "updating stack #{STACK_NAME} (id #{existing["Id"]})"
    req = Net::HTTP::Put.new(api("stacks/#{existing["Id"]}?endpointId=#{ENDPOINT_ID}"))
    req.body = JSON.generate(stackFileContent: compose, env: env, prune: true, pullImage: false)
  else
    puts "creating stack #{STACK_NAME}"
    req = Net::HTTP::Post.new(api("stacks/create/standalone/string?endpointId=#{ENDPOINT_ID}"))
    req.body = JSON.generate(name: STACK_NAME, stackFileContent: compose, env: env)
  end
  req["Content-Type"] = "application/json"
  result = http_request(req)
  puts "stack ok (id #{result["Id"]}, env: #{env.map { |e| e["name"] }.join(", ")})"
end

case ARGV.first
when nil
  build
  deploy_stack
when "build" then build
when "stack" then deploy_stack
else abort "usage: script/deploy [build|stack]"
end
